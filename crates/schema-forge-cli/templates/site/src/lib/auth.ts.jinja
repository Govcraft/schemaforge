// Owned file: regenerated on every `schema-forge site generate` run.
//
// Client-side auth plumbing:
// - `tokenStore`: sessionStorage-backed PASETO token holder (SSR-safe).
// - `login(...)`: POSTs credentials to /api/v1/forge/auth/login, stores
//   the returned token + expiry, and schedules a silent refresh ~5 min
//   before expiry. Does NOT go through the api-client `request()` helper
//   to avoid the 401 redirect loop when the store is empty.
// - `refreshToken()`: POSTs the current token to /api/v1/forge/auth/refresh
//   and returns a new one. Called both by the background scheduler and by
//   the api-clients' 401 retry path.
// - `logout()`: clears the token and navigates to /login.
// - `isAuthenticated()`: cheap presence check used by the route guard.
//
// Token expiry is persisted alongside the token so the refresh timer
// survives full-page reloads.

const TOKEN_KEY = "schemaforge.token"
const EXPIRES_KEY = "schemaforge.token_expires_at"
const ROLES_KEY = "schemaforge.roles"
const USERNAME_KEY = "schemaforge.username"
// The tenant the operator is currently acting within. Persisted so the
// choice survives reloads; sent verbatim as the `X-Active-Tenant` request
// header. Value shape is `<tenant_type>:<tenant_id>`, the same string the
// server's tenant_scope middleware parses.
const ACTIVE_TENANT_KEY = "schemaforge.active_tenant"

const API_BASE = (import.meta.env.VITE_API_BASE as string | undefined) ?? ""
const LOGIN_PATH = "/api/v1/forge/auth/login"
const REFRESH_PATH = "/api/v1/forge/auth/refresh"
const ME_PATH = "/api/v1/forge/auth/me"

/** The header the backend reads to scope a request to one of the caller's
 *  tenant memberships. Mirrors `ACTIVE_TENANT_HEADER` in the Rust
 *  `tenant_scope` middleware; surfaced here so callers don't hard-code it. */
export const ACTIVE_TENANT_HEADER = "X-Active-Tenant"

// Fire the background refresh this many ms before the token's stated
// `expires_at`. Five minutes gives the network and the refresh handler
// plenty of slack even on a flaky link.
const REFRESH_LEAD_MS = 5 * 60 * 1000

// Never schedule less than this many ms in the future. Guards against
// accidental tight loops when the clock is skewed or the lead time is
// longer than the token's remaining lifetime.
const MIN_SCHEDULE_MS = 10 * 1000

export type LoginResponse = {
  token: string
  expires_at: string
  /** Roles granted to the authenticated user. Stashed in sessionStorage
   *  so `@field_access` annotations can be enforced at render time. */
  roles: string[]
}

let refreshTimer: ReturnType<typeof setTimeout> | null = null

export const tokenStore = {
  get(): string | null {
    if (typeof window === "undefined") return null
    try {
      return window.sessionStorage.getItem(TOKEN_KEY)
    } catch {
      return null
    }
  },
  set(token: string, expiresAt: string, roles: string[]): void {
    if (typeof window === "undefined") return
    try {
      window.sessionStorage.setItem(TOKEN_KEY, token)
      window.sessionStorage.setItem(EXPIRES_KEY, expiresAt)
      window.sessionStorage.setItem(ROLES_KEY, JSON.stringify(roles))
    } catch {
      // sessionStorage quota / private mode: silently drop. The next
      // request will get a 401 and the guard will send the user to /login.
    }
  },
  getRoles(): string[] {
    if (typeof window === "undefined") return []
    try {
      const raw = window.sessionStorage.getItem(ROLES_KEY)
      if (!raw) return []
      const parsed = JSON.parse(raw)
      return Array.isArray(parsed)
        ? parsed.filter((r): r is string => typeof r === "string")
        : []
    } catch {
      return []
    }
  },
  getExpiresAt(): string | null {
    if (typeof window === "undefined") return null
    try {
      return window.sessionStorage.getItem(EXPIRES_KEY)
    } catch {
      return null
    }
  },
  setUsername(username: string): void {
    if (typeof window === "undefined") return
    try {
      window.sessionStorage.setItem(USERNAME_KEY, username)
    } catch {
      // sessionStorage quota / private mode: silently drop.
    }
  },
  getUsername(): string | null {
    if (typeof window === "undefined") return null
    try {
      return window.sessionStorage.getItem(USERNAME_KEY)
    } catch {
      return null
    }
  },
  clear(): void {
    if (typeof window === "undefined") return
    try {
      window.sessionStorage.removeItem(TOKEN_KEY)
      window.sessionStorage.removeItem(EXPIRES_KEY)
      window.sessionStorage.removeItem(ROLES_KEY)
      window.sessionStorage.removeItem(USERNAME_KEY)
      // Clear the active tenant alongside the token. Losing the session must
      // not strand a stale tenant selection that the next operator inherits.
      window.sessionStorage.removeItem(ACTIVE_TENANT_KEY)
    } catch {
      // Ignore — clear is best-effort.
    }
    if (refreshTimer !== null) {
      clearTimeout(refreshTimer)
      refreshTimer = null
    }
  },
}

/**
 * The tenant the operator is currently acting within.
 *
 * Switching tenants is a stateless, client-driven concern: the PASETO carries
 * the user's *full* membership set (`tenant_chain`); which membership scopes a
 * given request is chosen per-request by sending the `X-Active-Tenant` header.
 * This store holds that choice. The server independently rejects a header
 * naming a tenant the caller is not a member of (403), so this is convenience
 * + display, never the security boundary.
 */
export const activeTenantStore = {
  /** Current `<tenant_type>:<tenant_id>` header value, or `null` if unset. */
  get(): string | null {
    if (typeof window === "undefined") return null
    try {
      return window.sessionStorage.getItem(ACTIVE_TENANT_KEY)
    } catch {
      return null
    }
  },
  set(tenantType: string, tenantId: string): void {
    if (typeof window === "undefined") return
    try {
      window.sessionStorage.setItem(ACTIVE_TENANT_KEY, `${tenantType}:${tenantId}`)
    } catch {
      // sessionStorage quota / private mode: silently drop. Requests will
      // fall back to no header; a multi-membership user then gets the
      // server's 400 ACTIVE_TENANT_REQUIRED until the next successful set.
    }
  },
  clear(): void {
    if (typeof window === "undefined") return
    try {
      window.sessionStorage.removeItem(ACTIVE_TENANT_KEY)
    } catch {
      // Ignore — clear is best-effort.
    }
  },
}

function storeAndSchedule(body: LoginResponse): LoginResponse {
  tokenStore.set(body.token, body.expires_at, body.roles ?? [])
  scheduleRefresh(body.expires_at)
  return body
}

/**
 * Current user's roles, sourced from the last login/refresh response.
 * Returns an empty array when no user is logged in. Used to gate
 * role-scoped chrome (e.g. the platform_admin tenant badge).
 */
export function getCurrentRoles(): string[] {
  return tokenStore.getRoles()
}

/**
 * True if `required` is empty or intersects `held`. An empty gate list
 * means "no role restriction" — everybody passes.
 */
export function hasAnyRole(required: readonly string[], held: readonly string[]): boolean {
  if (required.length === 0) return true
  return required.some((r) => held.includes(r))
}

export async function login(
  username: string,
  password: string,
): Promise<LoginResponse> {
  const res = await fetch(`${API_BASE}${LOGIN_PATH}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ username, password }),
  })
  if (!res.ok) {
    if (res.status === 401) {
      throw new Error("Invalid username or password")
    }
    throw new Error(`Login failed: ${res.status}`)
  }
  const body = (await res.json()) as LoginResponse
  tokenStore.setUsername(username)
  return storeAndSchedule(body)
}

/** Currently-signed-in username (mirror of the value used to obtain the
 *  PASETO). `null` when the user is signed out. */
export function getCurrentUsername(): string | null {
  return tokenStore.getUsername()
}

/**
 * Exchange the currently-held token for a fresh one. Throws if no token
 * is stored, the refresh endpoint rejects the token (401), or the
 * network call fails outright. Callers should clear the token and
 * redirect to /login on failure.
 */
export async function refreshToken(): Promise<LoginResponse> {
  const current = tokenStore.get()
  if (!current) {
    throw new Error("no stored token")
  }
  const res = await fetch(`${API_BASE}${REFRESH_PATH}`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
      Authorization: `Bearer ${current}`,
    },
  })
  if (!res.ok) {
    if (res.status === 401) {
      tokenStore.clear()
    }
    throw new Error(`refresh failed: ${res.status}`)
  }
  const body = (await res.json()) as LoginResponse
  return storeAndSchedule(body)
}

/**
 * Schedule a background refresh relative to the supplied `expires_at`
 * ISO-8601 timestamp. Replaces any existing timer. Silently becomes a
 * no-op outside the browser (SSR) and when the computed delay would be
 * too small to be useful.
 */
function scheduleRefresh(expiresAt: string): void {
  if (typeof window === "undefined") return
  if (refreshTimer !== null) {
    clearTimeout(refreshTimer)
    refreshTimer = null
  }
  const expiryMs = Date.parse(expiresAt)
  if (Number.isNaN(expiryMs)) return
  const delay = Math.max(expiryMs - Date.now() - REFRESH_LEAD_MS, MIN_SCHEDULE_MS)
  refreshTimer = setTimeout(() => {
    refreshToken().catch(() => {
      // Silent: the next API call's 401 path will drive the user to /login.
    })
  }, delay)
}

/**
 * Re-arm the refresh timer on full-page load. Called from the app
 * entrypoint so a reloaded tab that still holds a valid token keeps
 * its silent refresh cadence.
 */
export function ensureRefreshScheduled(): void {
  const expiresAt = tokenStore.getExpiresAt()
  if (expiresAt) scheduleRefresh(expiresAt)
}

export function logout(): void {
  tokenStore.clear()
  if (typeof window !== "undefined") {
    window.location.replace("/login")
  }
}

export function isAuthenticated(): boolean {
  return tokenStore.get() !== null
}

// ---------------------------------------------------------------------------
// Principal / tenancy (`GET /auth/me`)
// ---------------------------------------------------------------------------

/** One of the caller's tenant memberships. Mirrors the Rust `TenantRef`
 *  (`{schema, entity_id}`); every entry is directly usable to build an
 *  `X-Active-Tenant: <schema>:<entity_id>` value. */
export type TenantRef = {
  schema: string
  entity_id: string
}

/** The tenant scoping the current session. Mirrors the Rust `ActiveTenant`
 *  (`{tenant_type, tenant_id}`). `tenant_type` equals the membership's
 *  `schema`; `tenant_id` equals its `entity_id`. */
export type ActiveTenant = {
  tenant_type: string
  tenant_id: string
}

/** Response of `GET /auth/me` — the browser cannot decrypt the PASETO, so
 *  this is the client-side anchor for "signed in as / current tenant" chrome
 *  and the tenant switcher. Mirrors the Rust `MeResponse`. */
export type MeResponse = {
  user_id: string
  email: string
  display_name: string | null
  roles: string[]
  /** The user's full membership set (every tenant they may operate in). */
  tenant_chain: TenantRef[]
  /** The tenant scoping this request: the sent `X-Active-Tenant` if a member,
   *  else the sole membership, else `null` (the client must choose). */
  active_tenant: ActiveTenant | null
  /** The header name to send to set/switch the active tenant. */
  active_tenant_header: string
}

/**
 * Fetch the authenticated principal and tenancy context. Sends the stored
 * `X-Active-Tenant` so the returned `active_tenant` reflects the operator's
 * current choice (the endpoint is exempt from tenant scoping, so it always
 * returns the *full* `tenant_chain` regardless of the header). Throws on a
 * missing token or non-200 so React Query surfaces the error state.
 */
export async function fetchMe(): Promise<MeResponse> {
  const token = tokenStore.get()
  if (!token) throw new Error("no stored token")
  const headers: Record<string, string> = {
    Authorization: `Bearer ${token}`,
  }
  const active = activeTenantStore.get()
  if (active) headers[ACTIVE_TENANT_HEADER] = active
  const res = await fetch(`${API_BASE}${ME_PATH}`, { headers })
  if (!res.ok) throw new Error(`auth/me failed: ${res.status}`)
  return (await res.json()) as MeResponse
}
