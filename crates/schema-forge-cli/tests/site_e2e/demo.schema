// Minimal fixture used by the Playwright e2e smoke test. Keep this
// narrow — the goal is to touch every render path the spec needs
// (composite, enum, relation, datetime), not to be a full example.

@display("name")
schema Company {
    name:     text(max: 255) required
    status:   enum("active", "archived") default("active")
    founded:  datetime
    address:  composite {
        city:        text(max: 128)
        postal_code: text(max: 32)
    }
}

@display("name")
@access(read: ["clerk", "finance"], write: ["clerk", "finance"], delete: ["finance"])
schema Job {
    name: text required
    timeout: duration required
    labels: map<text, integer>
    checksum: bytes
    delays: duration[]
    settings: composite {
        delay: duration
        counters: map<text, integer>
    }
    protected_group: composite {
        public_note: text
        private_note: text @field_access(write: ["finance"])
    }
    computed_label: text @compute("name + '-computed'")
    finance_only: text @field_access(read: ["finance"], write: ["finance"])
    review_note: text required default("server") @field_access(write: ["finance"])
}
